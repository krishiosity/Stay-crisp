<div class="crisp-hero">
  <div class="crisp-hero-holo"></div>
  <div class="crisp-wrap">
    <div class="crisp-hero-inner">
      <div>
        <h1>{{ section.settings.heading }}</h1>
        <p class="crisp-sub">{{ section.settings.subheading }}</p>
        <div class="crisp-badges">
          <div class="crisp-badge"><span class="ring"><svg viewBox="0 0 24 24"><line x1="7" y1="7" x2="17" y2="17"/><line x1="17" y1="7" x2="7" y2="17"/></svg></span>Zero<br>Nicotine</div>
          <div class="crisp-badge"><span class="ring"><svg viewBox="0 0 24 24"><path d="M12 5.5v13"/><path d="M12 6.5a3 3 0 0 0-5.4-1.8A2.6 2.6 0 0 0 4.3 8 2.7 2.7 0 0 0 4 12.8 2.7 2.7 0 0 0 6 17a2.6 2.6 0 0 0 3.4 1.4A2.6 2.6 0 0 0 12 18.5"/><path d="M12 6.5a3 3 0 0 1 5.4-1.8A2.6 2.6 0 0 1 19.7 8 2.7 2.7 0 0 1 20 12.8 2.7 2.7 0 0 1 18 17a2.6 2.6 0 0 1-3.4 1.4A2.6 2.6 0 0 1 12 18.5"/></svg></span>Caffeine +<br>Nootropics</div>
          <div class="crisp-badge"><span class="ring"><svg viewBox="0 0 24 24"><path d="M9.5 3h5"/><path d="M10 3v5.2L5.6 16a2 2 0 0 0 1.8 3h9.2a2 2 0 0 0 1.8-3L14 8.2V3"/><line x1="8" y1="14" x2="16" y2="14"/></svg></span>Lab<br>Tested</div>
          <div class="crisp-badge"><span class="ring"><svg viewBox="0 0 24 24"><rect x="4.5" y="6" width="15" height="12" rx="1.5"/><line x1="4.5" y1="9.5" x2="19.5" y2="9.5"/><line x1="9.5" y1="13" x2="19.5" y2="13"/><line x1="4.5" y1="16.3" x2="19.5" y2="16.3"/><rect x="4.5" y="6" width="7" height="3.5" fill="currentColor" stroke="none"/></svg></span>Made in<br>USA</div>
        </div>
        <div class="crisp-hero-cta">
          {%- if section.settings.button_label_1 != blank -%}
            <a class="crisp-btn solid" href="{{ section.settings.button_link_1 }}">{{ section.settings.button_label_1 }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="crisp-btn line" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      </div>
      <div class="crisp-hero-visual">
        <div class="crisp-can c1"></div>
        <div class="crisp-can c3"></div>
        <div class="crisp-can c2"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRISP Hero",
  "settings": [
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Flow.<br>Focus.<br>Energy."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A better way to perform."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Button 1 label",
      "default": "Shop Now →"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 label",
      "default": "Learn More →"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 link"
    }
  ],
  "presets": [
    {
      "name": "CRISP Hero"
    }
  ]
}
{% endschema %}
